
import heapq

# Goal state
goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

# Initial state
start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)

# Manhattan distance heuristic
def heuristic(state):
    distance = 0
    for i, tile in enumerate(state):
        if tile != 0:
            goal_pos = goal.index(tile)
            distance += abs(i // 3 - goal_pos // 3)
            distance += abs(i % 3 - goal_pos % 3)
    return distance

# Generate neighboring states
def get_neighbors(state):
    neighbors = []
    zero = state.index(0)
    row, col = zero // 3, zero % 3

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dr, dc in moves:
        nr, nc = row + dr, col + dc

        if 0 <= nr < 3 and 0 <= nc < 3:
            new_pos = nr * 3 + nc
            new_state = list(state)

            new_state[zero], new_state[new_pos] = (
                new_state[new_pos], new_state[zero]
            )

            neighbors.append(tuple(new_state))

    return neighbors

# A* search algorithm
def solve_puzzle(start):
    priority_queue = []
    heapq.heappush(priority_queue, (heuristic(start), 0, start, [start]))

    visited = {}

    while priority_queue:
        f, g, state, path = heapq.heappop(priority_queue)

        if state == goal:
            return path

        if state in visited and visited[state] <= g:
            continue

        visited[state] = g

        for neighbor in get_neighbors(state):
            new_g = g + 1

            if neighbor not in visited or new_g < visited[neighbor]:
                new_f = new_g + heuristic(neighbor)
                heapq.heappush(
                    priority_queue,
                    (new_f, new_g, neighbor, path + [neighbor])
                )

    return None

# Display the solution
solution = solve_puzzle(start)

if solution:
    print("Solution found!")
    print("Number of moves:", len(solution) - 1)

    for step, state in enumerate(solution):
        print("\nStep", step)
        for i in range(0, 9, 3):
            print(state[i:i+3])
else:
    print("No solution exists.")

